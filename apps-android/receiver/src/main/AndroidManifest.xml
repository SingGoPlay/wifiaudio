<?xml version="1.0" encoding="utf-8"?>
<!-- 从 WiFiAudio接收端-com.wifiaudio.receiver-4.20.apk 还原（versionCode=420 / versionName=4.20） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="WiFiAudio 接收端"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">

        <activity
            android:name="com.wifiaudio.receiver.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.wifiaudio.receiver.PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
